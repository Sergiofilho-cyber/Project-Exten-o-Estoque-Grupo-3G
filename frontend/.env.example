# Copie este arquivo para .env.local e preencha com os valores do Supabase
# de desenvolvimento. Peça os valores ao responsável pelo projeto, por
# mensagem privada. Nunca envie .env.local ao repositório.

# Endereço do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon). Segura no navegador por causa das regras do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço. Só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Só preencha para compartilhar a sessão entre subdomínios.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
